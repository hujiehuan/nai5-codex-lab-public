{
  "name": "nai5-codex-lab",
  "private": true,
  "version": "0.5.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "dev:mock": "vite --mode mock",
    "smoke": "node tests/e2e/smoke.mjs",
    "check:ui": "node tests/e2e/audit-ui.mjs",
    "test:browser": "node tests/e2e/probe-library.mjs && node tests/e2e/smoke.mjs && node tests/e2e/probe-studio.mjs",
    "test:e2e": "npm run test:browser && node tests/e2e/probe-eval.mjs && node tests/e2e/probe-studio-drop.mjs && node tests/e2e/probe-studio-image.mjs && node tests/e2e/probe-studio-reference-images.mjs && node tests/e2e/probe-studio-reference-content.mjs && node tests/e2e/probe-studio-skills.mjs && node tests/e2e/probe-model-selection.mjs && node tests/e2e/probe-updater.mjs",
    "test:eval": "node tests/e2e/probe-eval.mjs",
    "test:studio": "node tests/e2e/probe-studio.mjs",
    "test:studio-drop": "node tests/e2e/probe-studio-drop.mjs",
    "test:updater": "node tests/e2e/probe-updater.mjs",
    "test:studio-image": "node tests/e2e/probe-studio-image.mjs",
    "test:studio-references": "node tests/e2e/probe-studio-reference-images.mjs",
    "test:studio-skills": "node tests/e2e/probe-studio-skills.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "naive-ui": "^2.43.1",
    "pinia": "^3",
    "vue": "^3.5",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5",
    "prettier": "^3.6.2",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3",
    "vue-tsc": "^2"
  }
}
